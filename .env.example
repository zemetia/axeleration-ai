# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=MyApp

# API
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# Database (PostgreSQL) — this machine uses one shared Postgres container for every project
# under D:\Kerja (see D:\Kerja\shared-postgres), with a dedicated database per project.
DATABASE_URL="postgresql://postgres:password@localhost:5432/axeleration_ai?schema=public"

# Set to 1 to echo every SQL statement to stdout. Off by default: console writes are
# synchronous on Windows, so query logging blocks the event loop on every request.
PRISMA_LOG_QUERIES=

# NextAuth / Auth.js
AUTH_SECRET=                     # openssl rand -base64 32
AUTH_URL=http://localhost:3000   # Must match NEXT_PUBLIC_APP_URL in production

# Sentry (https://sentry.io)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# PostHog (https://posthog.com)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# App-level encryption (encrypts provider API keys stored per-project — never store plaintext)
APP_ENCRYPTION_KEY=              # 32-byte key, base64: openssl rand -base64 32

# Inngest (durable pipeline execution) — local dev uses `npx inngest-cli dev`, no keys needed.
# INNGEST_DEV=1 is required (not auto-detected) so the SDK targets the local dev server
# instead of Inngest Cloud — without it, inngest.send() throws "no signing key found".
INNGEST_DEV=1
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Local object storage (running on localhost for now — swap to R2/S3 later via src/lib/storage.ts only)
LOCAL_STORAGE_DIR=./storage
LOCAL_STORAGE_PUBLIC_BASE_URL=http://localhost:3000/media

# Optional platform-level fallback LLM key (used only if a project has no provider key configured)
PLATFORM_ANTHROPIC_API_KEY=

# Sumopod — OpenAI-compatible gateway (provider id "sumopod"); one key fronts GPT/Claude/Gemini/GLM/Qwen.
# Same fallback rule: a project's stored "sumopod" key wins, this is used when there isn't one.
# Model ids come from `GET $SUMOPOD_BASE_URL/models` — see src/providers/catalog.ts.
SUMOPOD_API_KEY=
SUMOPOD_BASE_URL=https://ai.sumopod.com/v1

# DeepSeek — OpenAI-compatible API (provider id "deepseek"), used directly (not via Sumopod's resale of it).
# Same fallback rule: a project's stored "deepseek" key wins, this is used when there isn't one.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# MCP transport: stdio (default, in-process) or http.
# `http` also enables the authenticated external endpoint at /api/mcp/[server].
MCP_TRANSPORT=stdio

# n8n notification fired when an episode reaches a terminal state (READY_FOR_REVIEW / DONE / FAILED).
# Leave the URL empty to disable. When the secret is set, the body is signed as x-signature-256: sha256=<hmac>.
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# Research agent: the web_search/fetch_page/search_x tools drive a real local Chrome over CDP instead
# of a paid search API (this app always runs local-first). Launch Chrome yourself with a debug port:
#   chrome --remote-debugging-port=9222 --user-data-dir="%TEMP%\research-chrome-profile"
# then leave the endpoint pointed at it. No key needed. Note that search_x needs an X session in that
# profile (logged-out x.com only shows a login wall), so either sign in there once or set X_BEARER_TOKEN.
RESEARCH_CDP_ENDPOINT=http://localhost:9222

# Optional research upgrades — everything still works without them, just one rung lower on the ladder.
# Brave: preferred over scraping DuckDuckGo when present (free tier ~2k queries/mo, api-dashboard.search.brave.com).
BRAVE_SEARCH_API_KEY=
# X/Twitter: app-only bearer token. The v2 *search* endpoints are not on X's free tier — without this,
# search_x falls back to reading x.com in the signed-in Chrome profile above.
X_BEARER_TOKEN=

# Video assembly: the RENDER stage shells out to a local ffmpeg/ffprobe (no vendor, no network call).
# Leave both blank to use whatever is on PATH; set FFMPEG_PATH to a full path when it is not, and
# FFPROBE_PATH only if the two binaries do not sit side by side.
FFMPEG_PATH=
FFPROBE_PATH=
